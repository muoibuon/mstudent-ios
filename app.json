{
  "expo": {
    "name": "MStudent",
    "slug": "mstudent",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mstudent",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.muoibuon.mstudent"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/logo-a-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#1D3AA0"
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*"
          ],
          "iosShareExtensionName": "MStudent Share"
        }
      ],
      "expo-secure-store",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
